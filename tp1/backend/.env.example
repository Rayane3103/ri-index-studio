# Copy this file to backend/.env for local dev. On Vercel, set the same names in Project > Settings > Environment Variables.

# Signs the login tokens. Long random text, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=change-me

# The two accounts. A password changed with "Forgot password" is saved in the store and wins over these.
ADMIN_EMAIL=admin@ri.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
USER_EMAIL=user@ri.local
USER_PASSWORD=change-me
USER_NAME=Guest user

# Online limits (leave empty on your PC = no limit). Vercel free = 2 GB of RAM.
MAX_DOCUMENTS_ONLINE=1500
MEMORY_BUDGET_MB=1500

# Upstash Redis (added for you by the Vercel Marketplace). Empty = a local JSON file is used.
KV_REST_API_URL=
KV_REST_API_TOKEN=
